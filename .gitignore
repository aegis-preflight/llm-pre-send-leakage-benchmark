# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Secrets and local config — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# Raw capture tempfiles (sanitized finals go in results/raw/*.json once locked)
results/raw/*.tmp
results/raw/*.partial
# Local dry-run outputs — never committed. The locked results live in
# results/raw/<tool>.json once the v1.0.0 tag ships.
results/raw/*.dryrun.json

# Generated paper artifacts — regenerated on demand via `make paper`.
# The v1.0.0 tag publishes final paper.html + paper.pdf as release assets.
paper/paper.html
paper/paper.pdf

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build
build/
dist/
coverage.xml
